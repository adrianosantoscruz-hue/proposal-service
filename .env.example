# ─────────────────────────────────────────────────────────────────────────────
# Asspontec Proposal Service — Variáveis de Ambiente
# Copie para .env e preencha com seus valores reais.
# NUNCA commite o .env no Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
# Encontre em: https://supabase.com/dashboard/project/<seu-projeto>/settings/api

# URL do seu projeto Supabase
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co

# service_role key — tem acesso total ao banco; NUNCA exponha no frontend
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# anon key — para verificação de tokens em modo mais restrito (opcional aqui)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT Secret — encontrado em: Project Settings > API > JWT Settings > JWT Secret
# É uma string longa (ex: super-secret-jwt-token-with-at-least-32-characters)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ── Storage ───────────────────────────────────────────────────────────────────
# Nome do bucket criado no Supabase Storage (crie um com este nome)
STORAGE_BUCKET=proposals

# True se o bucket for público (URLs diretas), False se for privado (signed URLs)
STORAGE_PUBLIC=true

# ── Serviço ───────────────────────────────────────────────────────────────────
DEBUG=false

# ── CORS ─────────────────────────────────────────────────────────────────────
# Liste as origens do seu frontend separadas por vírgula
# Exemplo: https://app.asspontec.com.br,https://staging.asspontec.com.br
# Use * apenas em desenvolvimento
CORS_ORIGINS=https://app.asspontec.com.br

# ── LibreOffice ───────────────────────────────────────────────────────────────
# Não precisa alterar se usar o Docker (já configurado no Dockerfile)
LIBREOFFICE_PATH=/usr/bin/libreoffice
